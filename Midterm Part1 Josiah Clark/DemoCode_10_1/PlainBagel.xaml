<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DemoCode_10_1.PlainBagel"
             Title="PlainBagel">
    <ScrollView>
        <VerticalStackLayout>
        <Image
            WidthRequest="400" HeightRequest="500" Source="https://imgs.search.brave.com/7ZBa4Gpg42v1w6CmHcAm8l95L0jP_QfzWA5BsKd9Efw/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9iYWdl/bGdyb3ZlLmNvbS9j/ZG4vc2hvcC9maWxl/cy9QbGFpbl9CYWdl/bC5qcGc_dj0xNzU2/MDQ0MjIzJndpZHRo/PTE0NDU"
                />
        <Label 
            Text="Plain Bagel" FontSize="60" 
                />
        <Label 
            Text="$3.50" TextColor="red" FontSize="40" Padding="6"
                />
        <Label 
            Text="Just A Bagel" Padding="5"
                />
        <Label 
            Text="In Stock" TextColor="Green" Padding="5"
                />
        <Label 
            Text="Quantity" Padding="5"
                />
        <Entry x:Name="QtyEntry" Placeholder="Enter Amount" 
                />
        <Button Text="Add to Cart" Clicked="Button_Clicked"  
                />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>  